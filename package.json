{
  "name": "vidrichka-fitness",
  "version": "1.4.0",
  "private": true,
  "description": "Vidrichka Fitness – offline-first personal fitness PWA (vanilla JS ES modules, zero runtime dependencies).",
  "type": "module",
  "scripts": {
    "start": "node tools/serve.mjs 8080",
    "preview": "node tools/serve.mjs 8080 dist",
    "build": "node tools/build.mjs",
    "build:beta": "node tools/build.mjs --beta",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p .",
    "test": "node --test tests/unit/*.test.js",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "test:e2e:dist": "npm run build && node tests/e2e/smoke.mjs --dir dist",
    "lighthouse": "node tools/lighthouse.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "icons": "node tools/make-icons.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@zxing/library": "^0.21.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "lighthouse": "^12.8.2",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
